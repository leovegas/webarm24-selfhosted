# ═══════════════════════════════════════════════════════════════════════════════════════════════
#  WebArm24 Self-hosted — configuration
#  `./webarmctl install` copies this to .env and generates every secret marked [generated].
#  Full reference: docs/03-configuration.md. After editing: ./webarmctl restart
# ═══════════════════════════════════════════════════════════════════════════════════════════════

# ── Required ────────────────────────────────────────────────────────────────────────────────────
# Public DNS name of this install (an A/AAAA record must point at this server for automatic HTTPS).
PUBLIC_HOST=automation.example.com
# Comma-separated admin e-mails. The first of them creates the admin account at https://PUBLIC_HOST/setup
ADMIN_EMAILS=admin@example.com

# [generated] Database password (letters/digits only — it is embedded in a URL).
POSTGRES_PASSWORD=
# [generated] Signs login tokens. Changing it signs everyone out.
JWT_SECRET=
# [generated] Fernet key that encrypts stored secrets (pipeline variables, trigger tokens, saved logins).
# NEVER change or lose it after first start: encrypted data becomes unreadable. Back it up with .env.
PIPELINE_FIELD_ENCRYPTION_KEY=

WEBARM_ENV=production

# ── Image (set by the bundle; change WEBARM_TAG only via `./webarmctl upgrade <tag>`) ────────────────
WEBARM_IMAGE=registry.webarm24.online/webarm/selfhosted
WEBARM_TAG=1.0.0

# ── License ─────────────────────────────────────────────────────────────────────────────────────
# The key lives in ./license/webarm_license (`./webarmctl license set license.key`) or is pasted at /setup.
# Weekly check-in fetches renewed keys automatically and sends only: license id, install id, version,
# number of user accounts. Set false for air-gapped installs (refresh keys manually; docs/13-air-gapped.md).
LICENSE_PHONE_HOME=true
# LICENSE_SERVER_URL=https://webarm24.online

# ── AI providers (at least one; keys stay on this server) ─────────────────────────────────────────
AI_PROVIDER=anthropic
ANTHROPIC_API_KEY=
# OPENAI_API_KEY=
# OPENROUTER_API_KEY=            # Gemini, Llama, DeepSeek, … in ai_agent steps
# CLAUDE_MODEL=claude-haiku-4-5
# OPENAI_MODEL=gpt-4o-mini
# AGENT_MAX_OUTPUT_TOKENS=8192

# ── E-mail (recommended: password resets, verification, approval mails, email steps) ────────────────
# Without SMTP, new accounts are verified automatically and password reset links appear in the logs.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
# Restrict where pipelines may send e-mail (optional):
# AGENT_EMAIL_ALLOW_DOMAINS=example.com
# AGENT_EMAIL_MAX_RECIPIENTS=20

# ── Sign-in ─────────────────────────────────────────────────────────────────────────────────────
# Google sign-in (optional). Redirect URI: https://PUBLIC_HOST/api/auth/google/callback
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=
# Let visitors use the API without an account (not recommended; accounts are what seats count):
# SELFHOST_ALLOW_ANONYMOUS=false

# ── Branding (optional) ─────────────────────────────────────────────────────────────────────────
# BRAND_NAME=Acme Automations
# BRAND_LOGO_URL=https://intranet.example.com/logo.svg
# SUPPORT_EMAIL=it-help@example.com        # shown to users in limit/error messages

# ── HTTPS (see docs/05-domain-tls.md) ──────────────────────────────────────────────────────────────
# ACME_EMAIL=admin@example.com             # Let's Encrypt expiry notices
# TLS_MODE=internal                        # LAN only: Caddy's internal CA instead of Let's Encrypt
# HTTP_PORT=80
# HTTPS_PORT=443

# ── Python steps (docs/10-security.md) ────────────────────────────────────────────────────────────
# none = no network; proxy = filtered public internet via the egress proxy (recommended); host = unrestricted
PIPELINE_PYTHON_NETWORK=proxy
# PIPELINE_PYTHON_EGRESS_ALLOW_HOSTS=        # e.g. googleapis.com,api.example.com
# PIPELINE_PYTHON_STEP_TIMEOUT_SEC=60
# PIPELINE_PYTHON_MEMORY_MAX_BYTES=1073741824
# PIPELINE_PYTHON_PACKAGES_INDEX_URL=        # private PyPI mirror
# AI_AGENT_ALLOW_PRIVATE_NETWORK=false       # true lets ai_agent web tools reach your intranet

# ── Browser ─────────────────────────────────────────────────────────────────────────────────────
PLAYWRIGHT_HEADLESS=true
# PLAYWRIGHT_VIDEO=false

# ── Scheduler / workflows ───────────────────────────────────────────────────────────────────────
# SCHEDULER_ENABLED=true
# WORKFLOW_MAX_CONCURRENCY=4

# ── Billing (off by default on self-hosted; enable to meter usage with internal credits) ────────────
# CREDITS_ENABLED=false
